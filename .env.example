# ============================================================
# China Dropship to Shopee — Environment Secrets
# Copy this file to .env and fill in your keys:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
# Or just run: python scripts/setup.py (it creates .env for you)
# ============================================================

# --- Google Gemini (caption + translation) ---
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- AliExpress Open Platform (product search) ---
# Free: https://openservice.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Shopee Open Platform (product posting) ---
# https://open.shopee.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
